{
  "name": "@fateforge/xpedition-cli",
  "version": "1.0.3",
  "description": "agent-native control of Siemens Xpedition: schematic, design library, board and fabrication outputs, every write previewed and verified",
  "license": "MIT",
  "author": "Sean Guo <guosong6886@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatecannotbealtered/xpedition-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xpedition-cli": "scripts/run.js"
  },
  "scripts": {
    "version": "node scripts/sync-version.js",
    "check-version": "node scripts/check-version.js"
  },
  "optionalDependencies": {
    "@fateforge/xpedition-cli-darwin-arm64": "1.0.3",
    "@fateforge/xpedition-cli-darwin-x64": "1.0.3",
    "@fateforge/xpedition-cli-linux-arm64": "1.0.3",
    "@fateforge/xpedition-cli-linux-x64": "1.0.3",
    "@fateforge/xpedition-cli-win32-arm64": "1.0.3",
    "@fateforge/xpedition-cli-win32-x64": "1.0.3"
  },
  "files": [
    "scripts/run.js",
    "skills/",
    "README.md",
    "README_zh.md",
    "*_zh.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "AGENTS.md",
    ".agent/",
    "docs/"
  ],
  "engines": {
    "node": ">=16"
  }
}
