    "@fateforge/xpedition-cli-darwin-x64": "2.0.0-dev.1",
    "@fateforge/xpedition-cli-linux-arm64": "2.0.0-dev.1",
    "@fateforge/xpedition-cli-linux-x64": "2.0.0-dev.1",
    "@fateforge/xpedition-cli-win32-arm64": "2.0.0-dev.1",
