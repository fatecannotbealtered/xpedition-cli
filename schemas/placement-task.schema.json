{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xpedition-cli:placement-task-input:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit",
    "selection",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "unit": {
      "const": "mm"
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "dx",
              "dy"
            ],
            "properties": {
              "op": {
                "const": "translate"
              },
              "dx": {
                "type": "number",
                "minimum": -100000.0,
                "maximum": 100000.0
              },
              "dy": {
                "type": "number",
                "minimum": -100000.0,
                "maximum": 100000.0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "angle",
              "origin"
            ],
            "properties": {
              "op": {
                "const": "rotate"
              },
              "angle": {
                "type": "number",
                "minimum": -100000.0,
                "maximum": 100000.0
              },
              "origin": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -100000.0,
                  "maximum": 100000.0
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "axis",
              "anchor"
            ],
            "properties": {
              "op": {
                "const": "align"
              },
              "axis": {
                "enum": [
                  "x",
                  "y"
                ]
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "axis",
              "start",
              "end"
            ],
            "properties": {
              "op": {
                "const": "distribute"
              },
              "axis": {
                "enum": [
                  "x",
                  "y"
                ]
              },
              "start": {
                "type": "number",
                "minimum": -100000.0,
                "maximum": 100000.0
              },
              "end": {
                "type": "number",
                "minimum": -100000.0,
                "maximum": 100000.0
              }
            }
          }
        ]
      }
    }
  },
  "description": "Origin-based tasks. Selection order defines distribution order; align anchor must be selected. No unplacing during preview, no route repair, flips or DRC simulation."
}
